# Portfolio Cache Prevention Configuration
# Disable caching for all portfolio files to ensure fresh content

<IfModule mod_headers.c>
    # Prevent caching of HTML, CSS, JS files
    <FilesMatch "\.(html|htm|css|js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header unset ETag
        FileETag None
    </FilesMatch>

    # Add timestamp header for cache busting
    Header set X-Cache-Timestamp "%D %t"
    Header set X-Portfolio-Version "2.2.0"
    Header set X-Build-Time "%D"
</IfModule>

<IfModule mod_expires.c>
    # Disable caching for dynamic content
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>

# Disable browser caching
<IfModule mod_env.c>
    SetEnv no-gzip 1
    SetEnv no-cache 1
    SetEnv must-revalidate 1
</IfModule>

# Add custom headers for debugging
Header always set X-Debug-Cache "DISABLED"
Header always set X-Fresh-Content "TRUE"

# Disable ETags completely
Header unset ETag
FileETag None

# Force revalidation
Header set Cache-Control "no-cache, no-store, must-revalidate, proxy-revalidate, max-age=0"
Header set Pragma "no-cache"
Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"

# Disable server signature for security
ServerSignature Off